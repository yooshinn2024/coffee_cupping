# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# 1. Cloudflare Tunnel Token
# Obtain from: Cloudflare Zero Trust -> Networks -> Tunnels -> Your Tunnel -> Token string after --token
TUNNEL_TOKEN=

# 2. Active Docker Compose Profiles
# - "tunnel": starts cloudflared alongside the app
# - "tunnel,autodeploy": starts both cloudflared and watchtower (auto-pulls new GHCR images from CI/CD)
COMPOSE_PROFILES=tunnel,autodeploy

# 3. Default Administrator Credentials (created automatically on first startup)
ADMIN_USER=admin
ADMIN_PASS=ineedacupofcoffee

# 4. Optional Host & App Settings
# APP_IMAGE=ghcr.io/yooshinn2024/coffee_cupping:latest
# APP_PORT=3000
# PUID=1000
# PGID=1000
# TZ=Asia/Tokyo
# REQUIRE_LOGIN_FOR_HOME=0
# WATCHTOWER_INTERVAL=300
# DOCKER_API_VERSION=1.44
