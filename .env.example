# 复制为 .env 后修改：  cp .env.example .env

# ① Cloudflare Tunnel 的 Token（Zero Trust → Networks → Tunnels → 你的隧道 → 安装命令里 --token 后面那一长串）
TUNNEL_TOKEN=

# ② 填了 Token 就保留这一行，cloudflared 会随 docker compose up -d 一起启动
COMPOSE_PROFILES=tunnel

# ③ 默认管理员账号与密码（首次启动自动创建，也可登录后在「设置」里修改）
ADMIN_USER=admin
ADMIN_PASS=ineedacupofcoffee

# ④ 可选配置
# APP_PORT=3000
# PUID=1000
# PGID=1000
# TZ=Asia/Tokyo
# REQUIRE_LOGIN_FOR_HOME=0
